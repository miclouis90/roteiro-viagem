rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/platformAdmins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/platformAdmins/$(request.auth.uid)
        ).data.active == true;
    }


    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function access(t) { return t.get('access', t.isPublic ? 'PUBLIC' : 'PRIVATE'); }
    function owner(t) { return signedIn() && t.get('ownerId', '') == request.auth.uid; }
    function legacyAdmin(t) { return !('ownerId' in t) && admin(); }
    function trip(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function isOwner(tripId) { return owner(trip(tripId)); }
    function isEditor(tripId) {
      return signedIn() && access(trip(tripId)) != 'PRIVATE'
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'editor';
    }
    function canEditTrip(tripId) {
      let t = trip(tripId);
      return signedIn() && (owner(t) || legacyAdmin(t) || isEditor(tripId) || access(t) == 'PUBLIC_EDIT');
    }
    function canRead(t, tripId) {
      return owner(t) || legacyAdmin(t) || isEditor(tripId) || t.isPublic == true;
    }
    function validAccess(d) {
      return (!('ownerId' in d) || (d.ownerId is string && d.ownerId.size() > 0 && d.ownerId.size() <= 128))
        && (!('access' in d) || (d.access in ['PRIVATE','SHARED','PUBLIC','PUBLIC_EDIT']
        && d.isPublic == (d.access in ['PUBLIC','PUBLIC_EDIT'])));
    }

    function date(v) {
      return v is string
        && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function text(v) {
      return v is string && v.size() <= 10000;
    }

    function url(v) {
      return v is string
        && v.size() <= 2048
        && (v == '' || v.matches('^https?://.*'));
    }

    // Optional, bounded maps. Old documents without these keys remain valid.
    function validTheme(t) {
      return t is map && t.keys().hasAll(['accent']) && t.keys().hasOnly(['accent'])
        && t.accent in ['green', 'blue', 'lavender', 'coral', 'gold'];
    }
    function detailText(d, key) {
      return d.get(key, '') is string && d.get(key, '').size() <= 1000;
    }
    function details_flight(d) {
      return d.type == 'flight' && d.keys().hasOnly([
          'type', 'company', 'flightNumber', 'originAirport', 'originCity', 'destinationAirport', 'destinationCity', 'departureTerminal', 'departureGate', 'arrivalTerminal', 'boardingTime', 'departureTime', 'arrivalTime', 'seat', 'bookingReference', 'baggage', 'notes'])
        && detailText(d, 'company')
        && detailText(d, 'flightNumber')
        && detailText(d, 'originAirport')
        && detailText(d, 'originCity')
        && detailText(d, 'destinationAirport')
        && detailText(d, 'destinationCity')
        && detailText(d, 'departureTerminal')
        && detailText(d, 'departureGate')
        && detailText(d, 'arrivalTerminal')
        && detailText(d, 'boardingTime') && (d.get('boardingTime', '') == '' || d.get('boardingTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && detailText(d, 'departureTime') && (d.get('departureTime', '') == '' || d.get('departureTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && detailText(d, 'arrivalTime') && (d.get('arrivalTime', '') == '' || d.get('arrivalTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && detailText(d, 'seat')
        && detailText(d, 'bookingReference')
        && detailText(d, 'baggage')
        && detailText(d, 'notes');
    }

    function details_restaurant(d) {
      return d.type == 'restaurant' && d.keys().hasOnly(['type', 'reservationTime', 'reservationName', 'reservationCode', 'phone', 'neighborhood', 'recommendedDish', 'notes'])
        && detailText(d, 'reservationTime') && (d.get('reservationTime', '') == '' || d.get('reservationTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && detailText(d, 'reservationName')
        && detailText(d, 'reservationCode')
        && detailText(d, 'phone')
        && detailText(d, 'neighborhood')
        && detailText(d, 'recommendedDish')
        && detailText(d, 'notes');
    }

    function details_bar(d) {
      return d.type == 'bar' && d.keys().hasOnly(['type', 'reservation', 'table', 'happyHour', 'signatureDrink', 'dressCode', 'notes'])
        && detailText(d, 'reservation')
        && detailText(d, 'table')
        && detailText(d, 'happyHour')
        && detailText(d, 'signatureDrink')
        && detailText(d, 'dressCode')
        && detailText(d, 'notes');
    }

    function details_culture(d) {
      return d.type == 'culture' && d.keys().hasOnly(['type', 'ticketUrl', 'ticketCode', 'session', 'seat', 'openingHours', 'exhibition', 'artist', 'notes'])
        && detailText(d, 'ticketUrl') && url(d.get('ticketUrl', ''))
        && detailText(d, 'ticketCode')
        && detailText(d, 'session')
        && detailText(d, 'seat')
        && detailText(d, 'openingHours')
        && detailText(d, 'exhibition')
        && detailText(d, 'artist')
        && detailText(d, 'notes');
    }

    function details_outdoor(d) {
      return d.type == 'outdoor' && d.keys().hasOnly(['type', 'meetingPoint', 'duration', 'whatToBring', 'reservation', 'weatherDependent', 'notes'])
        && detailText(d, 'meetingPoint')
        && detailText(d, 'duration')
        && detailText(d, 'whatToBring')
        && detailText(d, 'reservation')
        && d.get('weatherDependent', false) is bool
        && detailText(d, 'notes');
    }

    function details_transfer(d) {
      return d.type == 'transfer' && d.keys().hasOnly(['type', 'pickupLocation', 'dropoffLocation', 'company', 'driver', 'confirmation', 'duration'])
        && detailText(d, 'pickupLocation')
        && detailText(d, 'dropoffLocation')
        && detailText(d, 'company')
        && detailText(d, 'driver')
        && detailText(d, 'confirmation')
        && detailText(d, 'duration');
    }

    function details_car(d) {
      return d.type == 'car' && d.keys().hasOnly(['type', 'pickup', 'returnLocation', 'rentalCompany', 'reservation', 'vehicle'])
        && detailText(d, 'pickup')
        && detailText(d, 'returnLocation')
        && detailText(d, 'rentalCompany')
        && detailText(d, 'reservation')
        && detailText(d, 'vehicle');
    }

    function details_rail(d) {
      return d.type == 'rail' && d.keys().hasOnly(['type', 'origin', 'destination', 'line', 'platform', 'ticket'])
        && detailText(d, 'origin')
        && detailText(d, 'destination')
        && detailText(d, 'line')
        && detailText(d, 'platform')
        && detailText(d, 'ticket');
    }

    function lodgingCategory(c) {
      return c in ['Hotel', 'Airbnb/aluguel', 'Pousada', 'Hostel', 'Casa de amigos', 'Outro (hospedagem)'];
    }
    function details_lodging(d) {
      return d.type == 'lodging' && d.keys().hasAll(['checkOutDate'])
        && d.keys().hasOnly(['type','checkOutDate','checkOutTime','guests'])
        && date(d.checkOutDate)
        && detailText(d, 'checkOutTime')
        && (d.get('checkOutTime','') == '' || d.checkOutTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (!('guests' in d) || (d.guests is int && d.guests >= 1 && d.guests <= 10000));
    }
    function lodgingEvent(d) { return d.get('details', {}).get('type', '') == 'lodging'; }
    function privateLodgingAccess(tripId) {
      return isOwner(tripId) || legacyAdmin(trip(tripId)) || isEditor(tripId);
    }
    function validLodgingReservation(d, tripId, eventId) {
      return d.keys().hasAll(['updatedAt'])
        && d.keys().hasOnly(['bookingReference','bookingUrl','notes','updatedAt'])
        && detailText(d, 'bookingReference') && detailText(d, 'bookingUrl') && url(d.get('bookingUrl',''))
        && detailText(d, 'notes') && d.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/trips/$(tripId)/events/$(eventId)).data.details.type == 'lodging';
    }

    // Private financial planning. Reuse existing owner/member semantics,
    // never PUBLIC_EDIT by itself. No changes to public trip/event rules.
    function financialCategory(c) {
      return c in ['food','night','culture','outdoor','transport','lodging','other','insurance','connectivity','fees','shopping'];
    }
    function programCurrency(tripId) {
      let path = /databases/$(database)/documents/trips/$(tripId)/financialSettings/exchange;
      return exists(path) ? get(path).data.programCurrency : trip(tripId).currency;
    }
    function financialCurrency(c, tripId) { return c in ['BRL','USD',trip(tripId).currency,programCurrency(tripId)]; }
    function rateValue(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function validExchange(d, tripId, previous) {
      return d.keys().hasAll(['referenceCurrency','programCurrency','rates','cashFeeBps','cardFeeBps','updatedAt'])
        && d.keys().hasOnly(['referenceCurrency','programCurrency','rates','cashFeeBps','cardFeeBps','updatedAt'])
        && d.programCurrency == previous.get('programCurrency',trip(tripId).currency)
        && d.referenceCurrency in ['BRL','USD',d.programCurrency,trip(tripId).currency]
        && d.rates is map && d.rates.keys().hasOnly(['BRL','USD',d.programCurrency,trip(tripId).currency])
        && d.rates.get('BRL',1000000) == 1000000
        && rateValue(d.rates.get('USD',0)) && (!('USD' in d.rates) || d.rates.USD > 0)
        && rateValue(d.rates.get(d.programCurrency,0)) && (!(d.programCurrency in d.rates) || d.rates[d.programCurrency] > 0)
        && rateValue(d.rates.get(trip(tripId).currency,0)) && (!(trip(tripId).currency in d.rates) || d.rates[trip(tripId).currency] > 0)
        && d.cashFeeBps is int && d.cashFeeBps >= 0 && d.cashFeeBps <= 10000
        && d.cardFeeBps is int && d.cardFeeBps >= 0 && d.cardFeeBps <= 10000 && d.updatedAt == request.time;
    }
    function validDisbursement(d, tripId) {
      return !d.keys().hasAny(['settlementCurrency','settledCents','feesCents','effectiveRateMicros'])
        || (d.keys().hasAll(['settlementCurrency','settledCents','feesCents','effectiveRateMicros'])
        && financialCurrency(d.settlementCurrency,tripId)
        && d.settledCents is int && d.settledCents >= 0 && d.settledCents <= 10000000000000
        && d.feesCents is int && d.feesCents >= 0 && d.feesCents <= 10000000000000
        && d.effectiveRateMicros is int && d.effectiveRateMicros > 0 && d.effectiveRateMicros <= 1000000000000
        && (d.paidCents > 0 || (d.settledCents == 0 && d.feesCents == 0)));
    }
    function expenseCurrencyUnchanged(d, tripId, expenseId) {
      let paymentPath = /databases/$(database)/documents/trips/$(tripId)/financialPayments/$('expense:' + expenseId);
      return !exists(paymentPath) || get(paymentPath).data.paidCents == 0 || d.currency == resource.data.currency;
    }

    function validFinancialExpense(d, tripId) {
      return d.keys().hasAll(['name','category','amountCents','quantity','notes','currency','createdAt','updatedAt'])
        && d.keys().hasOnly(['name','category','amountCents','quantity','notes','currency','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && financialCategory(d.category)
        && d.amountCents is int && d.amountCents >= 0 && d.amountCents <= 1000000000
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 10000
        && d.notes is string && d.notes.size() <= 1000
        && financialCurrency(d.currency,tripId)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validDailyBudget(d, tripId, category) {
      return d.keys().hasAll(['category','dailyAmountCents','currency','updatedAt'])
        && d.keys().hasOnly(['category','dailyAmountCents','currency','updatedAt','paymentMethod'])
        && d.category == category && financialCategory(d.category) && d.category != 'lodging'
        && d.dailyAmountCents is int && d.dailyAmountCents >= 0 && d.dailyAmountCents <= 1000000000
        && paymentMethod(d.get('paymentMethod','undefined'))
        && financialCurrency(d.currency,tripId) && d.updatedAt == request.time;
    }

    function paymentMethod(m) { return m in ['undefined','cash','card','pix']; }
    function financialPaymentStatus(d, total, unknown) {
      return (d.status in ['planned','reserved'] && d.paidCents == 0)
        || (d.status == 'partial' && d.paidCents > 0 && (unknown || d.paidCents < total))
        || (d.status == 'paid' && !unknown && d.paidCents >= total);
    }
    function validFinancialPayment(d, tripId, paymentId, previous) {
      let collectionName = d.source == 'program' ? 'events' : 'financialExpenses';
      let sourcePath = /databases/$(database)/documents/trips/$(tripId)/$(collectionName)/$(d.sourceId);
      let sourceExists = exists(sourcePath);
      let source = sourceExists ? get(sourcePath).data : {};
      let total = !sourceExists ? 0 : d.source == 'expense' ? source.amountCents * source.quantity
        : source.isFree || source.status == 'cancelado' ? 0 : int(source.pricePerPerson * source.peopleCount * 100 + 0.5);
      let unknown = sourceExists && d.source == 'program' && !source.isFree && source.pricePerPerson == 0;
      let changePath = /databases/$(database)/documents/trips/$(tripId)/financialPayments/$(paymentId)/history/$(d.lastChangeId);
      let change = getAfter(changePath).data;
      return d.keys().hasAll(['source','sourceId','label','currency','paidCents','status','paymentMethod','createdAt','updatedAt','lastChangeId'])
        && d.keys().hasOnly(['source','sourceId','label','currency','paidCents','status','paymentMethod','createdAt','updatedAt','lastChangeId','settlementCurrency','settledCents','feesCents','effectiveRateMicros'])
        && d.source in ['program','expense'] && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 128 && d.sourceId.matches('^[^/]+$')
        && paymentId == d.source + ':' + d.sourceId && (sourceExists || previous.size() > 0)
        && d.label is string && d.label.size() > 0 && d.label.size() <= 120
        && financialCurrency(d.currency,tripId) && (previous.get('paidCents',0) == 0 || d.currency == previous.get('currency',d.currency))
        && (d.source != 'program' || !sourceExists || d.currency == programCurrency(tripId))
        && (previous.get('paidCents',0) == 0 || d.paidCents == 0 || d.get('settlementCurrency',d.currency) == previous.get('settlementCurrency',previous.currency))
        && (!('settlementCurrency' in previous) || d.keys().hasAll(['settlementCurrency','settledCents','feesCents','effectiveRateMicros']))
        && validDisbursement(d,tripId)
        && (d.source == 'program' || !sourceExists || source.currency == d.currency)
        && d.paidCents is int && d.paidCents >= 0 && d.paidCents <= 10000000000000
        && (d.paidCents <= total || d.paidCents <= previous.get('paidCents',0))
        && paymentMethod(d.paymentMethod) && financialPaymentStatus(d,total,unknown)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.lastChangeId is string && d.lastChangeId.size() > 0 && d.lastChangeId.size() <= 64 && d.lastChangeId.matches('^[^/]+$')
        && d.lastChangeId != previous.get('lastChangeId','') && !exists(changePath)
        && change.previousPaidCents == previous.get('paidCents',0)
        && change.paidCents == d.paidCents && change.paymentMethod == d.paymentMethod && change.status == d.status
        && change.source == d.source && change.sourceId == d.sourceId && change.label == d.label && change.currency == d.currency
        && change.get('settlementCurrency',d.currency) == d.get('settlementCurrency',d.currency)
        && change.get('settledCents',d.paidCents) == d.get('settledCents',d.paidCents)
        && change.get('feesCents',0) == d.get('feesCents',0) && change.get('effectiveRateMicros',1000000) == d.get('effectiveRateMicros',1000000)
        && change.get('previousSettlementCurrency',previous.get('currency',d.currency)) == previous.get('settlementCurrency',previous.get('currency',d.currency))
        && change.get('previousSettledCents',previous.get('paidCents',0)) == previous.get('settledCents',previous.get('paidCents',0))
        && change.get('previousFeesCents',0) == previous.get('feesCents',0)
        && change.changedAt == request.time && change.changedBy == request.auth.uid;
    }
    function validFinancialChange(d, tripId, paymentId, changeId) {
      let payment = getAfter(/databases/$(database)/documents/trips/$(tripId)/financialPayments/$(paymentId)).data;
      return d.keys().hasAll(['source','sourceId','label','currency','paidCents','status','paymentMethod','previousPaidCents','changedAt','changedBy'])
        && d.keys().hasOnly(['source','sourceId','label','currency','paidCents','status','paymentMethod','previousPaidCents','changedAt','changedBy','settlementCurrency','settledCents','feesCents','effectiveRateMicros','previousSettlementCurrency','previousSettledCents','previousFeesCents'])
        && payment.lastChangeId == changeId && payment.updatedAt == request.time
        && d.source == payment.source && d.sourceId == payment.sourceId && d.label == payment.label && d.currency == payment.currency
        && d.paidCents == payment.paidCents && d.status == payment.status && d.paymentMethod == payment.paymentMethod
        && d.previousPaidCents is int && d.previousPaidCents >= 0 && d.previousPaidCents <= 10000000000000
        && validDisbursement(d,tripId)
        && d.get('settlementCurrency',d.currency) == payment.get('settlementCurrency',payment.currency)
        && d.get('settledCents',d.paidCents) == payment.get('settledCents',payment.paidCents)
        && d.get('feesCents',0) == payment.get('feesCents',0)
        && d.get('effectiveRateMicros',1000000) == payment.get('effectiveRateMicros',1000000)
        && d.changedAt == request.time && d.changedBy == request.auth.uid;
    }

    function validDetails(d) {
      return d is map && d.keys().hasAll(['type'])
        && (d.type == 'lodging' ? details_lodging(d) : d.type == 'flight' ? details_flight(d) : d.type == 'restaurant' ? details_restaurant(d) : d.type == 'bar' ? details_bar(d) : d.type == 'culture' ? details_culture(d) : d.type == 'outdoor' ? details_outdoor(d) : d.type == 'transfer' ? details_transfer(d) : d.type == 'car' ? details_car(d) : d.type == 'rail' ? details_rail(d) : false);
    }

    function validTrip(d) {
      return d.keys().hasAll([
          'title',
          'destinationCity',
          'destinationState',
          'country',
          'startDate',
          'endDate',
          'travelerName',
          'description',
          'notes',
          'status',
          'isPublic',
          'currency',
          'createdAt',
          'updatedAt'
        ])
        && d.keys().hasOnly(['ownerId', 'access', 'theme',
          'title',
          'destinationCity',
          'destinationState',
          'country',
          'startDate',
          'endDate',
          'travelerName',
          'description',
          'notes',
          'status',
          'isPublic',
          'currency',
          'createdAt',
          'updatedAt'
        ])
        && validAccess(d)
        && ('theme' in d ? validTheme(d.theme) : true)
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 120
        && text(d.destinationCity)
        && d.destinationCity.size() > 0
        && text(d.destinationState)
        && text(d.country)
        && d.country.size() > 0
        && text(d.travelerName)
        && text(d.description)
        && text(d.notes)
        && date(d.startDate)
        && date(d.endDate)
        && d.endDate >= d.startDate
        && d.status in ['planejamento', 'confirmada', 'concluída']
        && d.isPublic is bool
        && d.currency in [
          'BRL',
          'USD',
          'EUR',
          'GBP',
          'ARS',
          'CLP',
          'JPY',
          'CAD',
          'AUD',
          'CHF',
          'MXN',
          'UYU',
          'COP',
          'PEN'
        ]
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    function validEvent(d, tripId) {
      let trip = get(
        /databases/$(database)/documents/trips/$(tripId)
      ).data;

      return d.keys().hasAll([
          'title',
          'description',
          'date',
          'startTime',
          'endTime',
          'location',
          'category',
          'websiteUrl',
          'instagramUrl',
          'mapsUrl',
          'genericUrl',
          'pricePerPerson',
          'peopleCount',
          'isFree',
          'notes',
          'status',
          'priority',
          'createdAt',
          'updatedAt'
        ])
        && d.keys().hasOnly([
          'details',
          'title',
          'description',
          'date',
          'startTime',
          'endTime',
          'location',
          'category',
          'websiteUrl',
          'instagramUrl',
          'mapsUrl',
          'genericUrl',
          'pricePerPerson',
          'peopleCount',
          'isFree',
          'notes',
          'status',
          'priority',
          'createdAt',
          'updatedAt'
        ])
        && ('details' in d ? validDetails(d.details) : true)
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 120
        && text(d.description)
        && text(d.location)
        && text(d.category)
        && text(d.notes)
        && date(d.date)
        && d.date >= trip.startDate
        && d.date <= trip.endDate
        && d.startTime is string
        && ((lodgingEvent(d) && d.startTime == '') || d.startTime.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        ))
        && d.endTime is string
        && (
          d.endTime == ''
          || (
            d.endTime.matches(
              '^([01][0-9]|2[0-3]):[0-5][0-9]$'
            )
            && d.endTime >= d.startTime
          )
        )
        && url(d.websiteUrl)
        && url(d.instagramUrl)
        && url(d.mapsUrl)
        && url(d.genericUrl)
        && d.pricePerPerson is number
        && d.pricePerPerson >= 0
        && d.pricePerPerson <= 10000000
        && d.peopleCount is int
        && d.peopleCount >= 1
        && d.peopleCount <= 10000
        && (!lodgingEvent(d) || (lodgingCategory(d.category)
          && d.details.checkOutDate > d.date && d.details.checkOutDate <= trip.endDate
          && d.endTime == '' && d.peopleCount == 1 && d.location.size() > 0))
        && d.isFree is bool
        && (!d.isFree || d.pricePerPerson == 0)
        && d.status in [
          'ideia',
          'reservado',
          'confirmado',
          'realizado',
          'cancelado'
        ]
        && d.priority in [
          'imperdível',
          'gostaria de ir',
          'opcional'
        ]
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    // Cada usuário autenticado pode consultar apenas
    // seu próprio status de administrador.
    match /platformAdmins/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    // A member may discover only their own memberships. uid supports a collection-group query.
    match /{path=**}/members/{uid} {
      allow get: if signedIn() && uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /trips/{tripId} {
      allow get: if canRead(resource.data, tripId);
      // Public links allow GET, never discovery of unrelated trips.
      allow list: if owner(resource.data);
      allow create: if signedIn() && admin() && validTrip(request.resource.data)
        && request.resource.data.get('ownerId', request.auth.uid) == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validTrip(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        // Currency is the original unit of programs; reference changes use private exchange settings.
        && (!exists(/databases/$(database)/documents/trips/$(tripId)/financialSettings/exchange)
          || request.resource.data.currency == resource.data.currency)
        && (
          (owner(resource.data) && request.resource.data.ownerId == resource.data.ownerId)
          || (legacyAdmin(resource.data) && request.resource.data.get('ownerId', '') == request.auth.uid
            && request.resource.data.isPublic == resource.data.isPublic
            && request.resource.data.access == access(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','access','updatedAt']))
          || (canEditTrip(tripId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title','destinationCity','destinationState','country','startDate','endDate','travelerName',
            'description','notes','status','currency','theme','updatedAt'
          ]))
        );
      allow delete: if isOwner(tripId);
      match /events/{eventId} {
        allow read: if canRead(trip(tripId), tripId);
        allow create: if canEditTrip(tripId) && validEvent(request.resource.data, tripId)
          && request.resource.data.createdAt == request.time;
        allow update: if canEditTrip(tripId) && validEvent(request.resource.data, tripId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canEditTrip(tripId);
      }
      match /lodgingReservations/{eventId} {
        allow read: if privateLodgingAccess(tripId);
        allow create, update: if privateLodgingAccess(tripId) && validLodgingReservation(request.resource.data, tripId, eventId);
        allow delete: if privateLodgingAccess(tripId);
      }
      match /financialExpenses/{expenseId} {
        allow read: if privateLodgingAccess(tripId);
        allow create: if privateLodgingAccess(tripId) && validFinancialExpense(request.resource.data, tripId)
          && request.resource.data.createdAt == request.time;
        allow update: if privateLodgingAccess(tripId) && validFinancialExpense(request.resource.data, tripId)
          && request.resource.data.createdAt == resource.data.createdAt
          && expenseCurrencyUnchanged(request.resource.data,tripId,expenseId);
        allow delete: if privateLodgingAccess(tripId);
      }
      match /financialDailyBudgets/{category} {
        allow read: if privateLodgingAccess(tripId);
        allow create, update: if privateLodgingAccess(tripId) && validDailyBudget(request.resource.data, tripId, category);
        allow delete: if privateLodgingAccess(tripId);
      }
      match /financialSettings/{settingId} {
        allow read: if privateLodgingAccess(tripId);
        allow create: if settingId == 'exchange' && privateLodgingAccess(tripId) && validExchange(request.resource.data,tripId,{});
        allow update: if settingId == 'exchange' && privateLodgingAccess(tripId) && validExchange(request.resource.data,tripId,resource.data);
        allow delete: if isOwner(tripId);
      }
      match /financialPayments/{paymentId} {
        allow read: if privateLodgingAccess(tripId);
        allow create: if privateLodgingAccess(tripId) && validFinancialPayment(request.resource.data, tripId, paymentId, {})
          && request.resource.data.createdAt == request.time;
        allow update: if privateLodgingAccess(tripId) && validFinancialPayment(request.resource.data, tripId, paymentId, resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(tripId);
        match /history/{changeId} {
          allow read: if privateLodgingAccess(tripId);
          allow create: if privateLodgingAccess(tripId) && validFinancialChange(request.resource.data, tripId, paymentId, changeId);
          allow update: if false;
          allow delete: if isOwner(tripId);
        }
      }
      match /members/{uid} {
        allow get: if isOwner(tripId) || (signedIn() && uid == request.auth.uid);
        allow list: if isOwner(tripId);
        allow create: if signedIn() && request.resource.data.keys().hasAll(['uid','role','displayName','email','addedAt'])
          && request.resource.data.keys().hasOnly(['uid','role','displayName','email','addedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.role in ['owner','editor']
          && (request.resource.data.role != 'owner' || trip(tripId).ownerId == uid)
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && request.resource.data.addedAt == request.time
          && (isOwner(tripId) || (uid == request.auth.uid && access(trip(tripId)) == 'PUBLIC_EDIT'
            && request.resource.data.role == 'editor'
            && request.resource.data.email == request.auth.token.get('email','')
            && request.resource.data.displayName == request.auth.token.get('name','')));
        allow update: if false;
        allow delete: if isOwner(tripId) || (signedIn() && uid == request.auth.uid && resource.data.role == 'editor');
      }
    }
  }
}
